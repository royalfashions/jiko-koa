    }

    .category{
        padding:12px 4px;
    }

    .category-icon{
        font-size:28px;
    }

    .category-name{
        font-size:10px;
    }

    .products{
        grid-template-columns:repeat(2,1fr);
        gap:9px;
    }

    .product-image{
        height:145px;
    }

    .product-info{
        padding:10px;
    }

    .product-name{
        font-size:13px;
    }

    .price{
        font-size:17px;
    }

    .benefits{
        grid-template-columns:repeat(2,1fr);
        gap:8px;
    }

    .review-grid{
        grid-template-columns:1fr;
    }

    .location{
        flex-direction:column;
        align-items:flex-start;
    }

    .footer-grid{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:420px){

    .categories{
        grid-template-columns:repeat(3,1fr);
    }

    .footer-grid{
        grid-template-columns:1fr;
    }
