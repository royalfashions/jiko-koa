    color:#222;
}

/* TOP BAR */

.top-bar{
    background:#f68b1e;
    color:white;
    padding:7px 5%;
    font-size:13px;
    display:flex;
    justify-content:space-between;
}

/* HEADER */

header{
    background:#f68b1e;
    color:white;
    position:sticky;
    top:0;
    z-index:1000;
    box-shadow:0 2px 8px rgba(0,0,0,.25);
}

.header-main{
    max-width:1250px;
    margin:auto;
    padding:14px 18px;
    display:flex;
    align-items:center;
    gap:20px;
}

.logo{
    font-size:28px;
    font-weight:900;
    white-space:nowrap;
}

.logo span{
    display:block;
    font-size:11px;
    letter-spacing:2px;
    text-align:center;
}

.search-box{
    flex:1;
    display:flex;
    background:white;
    border-radius:5px;
    overflow:hidden;
}

.search-box input{
    width:100%;
    padding:14px;
    border:none;
    outline:none;
    font-size:15px;
}

.search-box button{
    border:none;
    background:#ff9900;
    color:white;
    padding:0 22px;
    font-size:20px;
    cursor:pointer;
}

.header-link{
    color:white;
    font-weight:bold;
    cursor:pointer;
    white-space:nowrap;
}

.cart-button{
    position:relative;
    cursor:pointer;
    font-size:25px;
}

.cart-count{
    position:absolute;
    top:-9px;
    right:-10px;
    background:#e60000;
    color:white;
    width:20px;
    height:20px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:11px;
    font-weight:bold;
}

/* NAV */

.navbar{
    background:#fff;
    border-bottom:1px solid #ddd;
}

.nav-inner{
    max-width:1250px;
    margin:auto;
    padding:11px 18px;
    display:flex;
    gap:25px;
    overflow:auto;
}

.nav-inner a{
    text-decoration:none;
    color:#333;
    font-weight:bold;
    white-space:nowrap;
}

.nav-inner a:hover{
    color:#f68b1e;
}

/* MAIN */

.container{
    max-width:1250px;
    margin:auto;
    padding:18px;
}

/* HERO */

.hero{
    min-height:340px;
    border-radius:8px;
    overflow:hidden;
    background:
    linear-gradient(90deg,rgba(0,0,0,.85),rgba(0,0,0,.25)),
    linear-gradient(135deg,#111,#555);
    display:flex;
    align-items:center;
    color:white;
    margin-bottom:22px;
}

.hero-content{
    padding:45px;
    max-width:650px;
}

.hero h1{
    font-size:48px;
    margin-bottom:12px;
}

.hero p{
    font-size:19px;
    line-height:1.6;
    margin-bottom:25px;
}

.hero-btn{
    display:inline-block;
    background:#f68b1e;
    color:white;
    padding:14px 28px;
    border-radius:5px;
    text-decoration:none;
    font-weight:bold;
}

/* SECTION */

.section-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:25px 0 15px;
}

.section-title h2{
    font-size:24px;
}

.section-title a{
    color:#f68b1e;
    font-size:14px;
    font-weight:bold;
}

/* CATEGORIES */

.categories{
    display:grid;
    grid-template-columns:repeat(7,1fr);
    gap:12px;
}

.category{
    background:white;
    border-radius:7px;
    padding:18px 8px;
    text-align:center;
    box-shadow:0 1px 5px rgba(0,0,0,.12);
    cursor:pointer;
    transition:.2s;
}

.category:hover{
    transform:translateY(-3px);
    box-shadow:0 4px 10px rgba(0,0,0,.18);
}

.category-icon{
    font-size:38px;
    margin-bottom:8px;
}

.category-name{
    font-size:13px;
    font-weight:bold;
}

/* FLASH SALE */

.flash{
    background:white;
    border-radius:8px;
    padding:18px;
    margin-top:25px;
}

.flash-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}

.flash-header h2{
    color:#e60000;
}

.timer{
    background:#222;
    color:white;
    padding:8px 12px;
    border-radius:4px;
    font-weight:bold;
}

/* PRODUCTS */

.products{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:15px;
}

.product{
    background:white;
    border-radius:7px;
    overflow:hidden;
    box-shadow:0 1px 5px rgba(0,0,0,.12);
    position:relative;
    transition:.2s;
}

.product:hover{
    transform:translateY(-3px);
    box-shadow:0 5px 14px rgba(0,0,0,.18);
}

.product-image{
    height:190px;
    background:linear-gradient(135deg,#eee,#ddd);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:70px;
}

.badge{
    position:absolute;
    left:9px;
    top:9px;
    background:#e60000;
    color:white;
    padding:5px 8px;
    border-radius:3px;
    font-size:11px;
    font-weight:bold;
}

.product-info{
    padding:13px;
}

.product-name{
    min-height:38px;
    font-size:14px;
    line-height:1.4;
}

.stars{
    color:#ffb400;
    margin:6px 0;
    font-size:13px;
}

.reviews{
    color:#888;
    font-size:11px;
}

.price{
    font-size:19px;
    font-weight:bold;
    margin-top:7px;
}

.old-price{
    color:#999;
    text-decoration:line-through;
    font-size:12px;
    margin-top:3px;
}

.add-cart{
    width:100%;
    border:none;
    background:#f68b1e;
    color:white;
    padding:11px;
    border-radius:4px;
    margin-top:9px;
    font-weight:bold;
    cursor:pointer;
}

.add-cart:hover{
    background:#dd7200;
}

/* BENEFITS */

.benefits{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin:25px 0;
}

.benefit{
    background:white;
    padding:25px 15px;
    text-align:center;
    border-radius:7px;
}

.benefit-icon{
    font-size:32px;
    margin-bottom:8px;
}

.benefit h3{
    font-size:15px;
    margin-bottom:5px;
}

.benefit p{
    color:#777;
    font-size:12px;
    line-height:1.5;
}

/* REVIEWS */

.reviews-section{
    background:white;
    border-radius:8px;
    padding:22px;
    margin-top:25px;
}

.review-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.review{
    border:1px solid #eee;
    padding:18px;
    border-radius:6px;
}

.review-stars{
    color:#ffb400;
    margin-bottom:8px;
}

.review p{
    color:#555;
    font-size:14px;
    line-height:1.5;
}

.review strong{
    display:block;
    margin-top:10px;
}

/* LOCATION */

.location{
    background:#222;
    color:white;
    border-radius:8px;
    padding:30px;
    margin-top:25px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
